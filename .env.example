# Copy to .env for local development. Never commit .env.
# On Render, set these in the dashboard under Environment instead.

# Postgres connection string. Leave unset locally to use a local SQLite
# file (nkr.db) for testing only — Render always sets DATABASE_URL.
DATABASE_URL=

# Local SQLite file path (only used when DATABASE_URL is unset).
SQLITE_PATH=./nkr.db

# PIN protecting the Orders and Store setup tabs. Required on Render.
# If unset, the store tabs are open (local development only) and the
# server logs a warning on startup.
STORE_PIN=

# Twilio SMS alerts for new orders. Leave all three unset to disable
# texting; orders still work normally. The owner supplies these later.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Recipients for new-order texts (comma-separated, E.164).
# Defaults to the two store numbers if unset.
TWILIO_ALERT_TO=+12174189581,+16036745740

PORT=3000
